# PayBack Backend Configuration

# Environment
app_env=development
payback_env=development
database_mode=memory
log_level=INFO

# Razorpay (TEST MODE ONLY)
razorpay_key_id=
razorpay_key_secret=
razorpay_webhook_secret=

# Messaging Delivery Providers
# Options: 'mock' | 'resend' | 'smtp' | 'whatsapp'
message_delivery_provider=resend

# Resend Email Configuration
resend_api_key=
resend_from_email=onboarding@resend.dev

# SMTP Email Configuration (fallback)
smtp_host=
smtp_port=587
smtp_user=
smtp_password=
smtp_from_email=recovery@payback.ai

# Authentication
auth_enabled=false
jwt_secret_key=payback-dev-secret-key-change-in-production-1234567890
jwt_algorithm=HS256
jwt_access_token_expire_minutes=1440

# LLM Provider: "ollama" | "huggingface" | "mock"
llm_provider=ollama
ollama_base_url=http://localhost:11434
ollama_model=qwen2.5:3b

# CORS Configuration
cors_allowed_origins=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
